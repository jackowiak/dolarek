extends layout/head

block title
  title DOLLAR MODA by Henryk Brzeski

block content
  body#project-page
    .global-outer
      .global-inner
        header#sidebar
          .sidebar-inner
            include layout/navigation
        main#main
          .main-outer
            .container-fluid

              //- Definicja mixina video-item z argumentami
              mixin video-item(src, dataVideoId, caption)
                .row
                  .col-md-12
                    .project-image
                      video(
                        src=src,
                        autoplay,
                        loop,
                        muted,
                        playsinline,
                        preload='none',
                        data-video-id=dataVideoId,
                        onclick='openVideoModal(this)'
                      )
                      if caption
                        .picture
                          .content
                            .text
                              h2= caption

              //- Wywołania mixina z różnymi video
              +video-item('img/projects/video/tylemam.mp4', 'https://iframe.mediadelivery.net/embed/425607/039711d6-f60f-4f48-9825-44655a582c52?autoplay=true&loop=false&muted=false&preload=true&responsive=true', null)
              +video-item('img/projects/video/tacet.mp4', 'ntCnydwV5wM', null)
              +video-item('img/projects/video/bnr.mp4', 'imlzBFMq48A', null)
              +video-item('img/projects/video/proch.mp4', 'https://iframe.mediadelivery.net/embed/425607/476d8d88-4438-4865-a73f-820a8012cd88?autoplay=true&loop=false&muted=false&preload=true&responsive=true', null)
              +video-item('img/projects/video/catchup.mp4', 'irPZYl5F-Bg', null)
              +video-item('img/projects/video/kemo.mp4', 'https://iframe.mediadelivery.net/embed/425607/f00126b4-242e-4a93-aaa4-b440beacfde0?autoplay=true&loop=false&muted=false&preload=true&responsive=true', null)
              +video-item('img/projects/video/synek.mp4', 'tuFr-j23nHQ', null)
              +video-item('img/projects/video/bdawg.mp4', 'https://iframe.mediadelivery.net/embed/425607/7e310ffd-e5f5-4895-8ec8-d0c951eb59d2?autoplay=true&loop=false&muted=false&preload=true&responsive=true', 'bdawg')

          //- Modal do YouTube
          #video-modal.modal
            .modal-content
              iframe#yt-player(
                width='100%',
                height='100%',
                frameborder='0',
                allow='autoplay; fullscreen',
                allowfullscreen,
                playsinline
              )
            button.close(onclick='closeVideoModal()') ✕

    include layout/js

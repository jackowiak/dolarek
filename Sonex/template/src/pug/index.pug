extends layout/head
block title
	title DOLLAR MODA by Henryk Brzeski
block content
	body#index-page
		.global-outer
			.global-inner
				header#sidebar
					.sidebar-inner
						include layout/navigation
				main#main
					.main-outer
						.container-fluid
							.row
								.col-md-12
									#works-grid
										.gutter
										mixin works-item(title, categories, list, img, slug)
											a(class='works-item active smooth-leave ' + categories, href=`${slug}.html`)
												.picture
													.content
														.text
															h2=title
															ul
																each val in list
																	li=val
													img(src=img, alt='')
										+works-item('Ćpaj Stajl - Lato w ghettcie', 'Vinyl release design', ['Vinyl release design'], 'img/projects/cs_lwg/thumbnail.png', 'lato_w_ghettcie')
										+works-item('Ćpaj Stajl - Melodramat', 'CD release design', ['CD release design'], 'img/projects/cs_melodramat/thumbnail.png', 'melodramat')
										+works-item('Ćpaj Stajl - Białe szaleństwo', 'CD release design', ['CD release design'], 'img/projects/cs_bs/thumbnail.png', 'biale_szalenstwo')
										+works-item("Ćpaj Stajl - Złoty strzał", 'Digital cover', ['Digital cover'], 'img/projects/cs_zs/thumbnail.png', 'zloty_strzal')
										+works-item("Kacperczyk", 'Poster series', ['Poster series'], 'img/projects/kacperczyk/thumbnail.png', 'kacperczyk')
										+works-item('Lordofon', 'Visual branding', ['Creative Direction', 'Set Design', 'Graphic Design'], 'img/projects/lordofon/thumbnail.png', 'lordofon')
										+works-item('Tacet', 'illustration typography', ['Visual Concept', 'Graphic Design', 'Video Production'], 'img/projects/tacet/thumbnail.png', 'tacet')
										+works-item('Rest of works 2023-2025', 'From other orbits', ['From other orbits'], 'img/projects/rest/thumbnail.png', 'other')
								//- .row
								//- 	.col-md-12
								//- 		.load-more
								//- 			a.btn(href='#') Load More huju
		include layout/js
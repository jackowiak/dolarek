script.
  const modal = document.getElementById('video-modal');
  const iframe = document.getElementById('yt-player');

  function openVideoModal(el) {
    if (!modal || !iframe) return;
    const videoId = el.dataset.videoId;
    console.log('openVideoModal videoId:', videoId);
    if (!videoId) {
      console.warn('Brak data-video-id w elemencie:', el);
      return;
    }

    modal.classList.add('active');

    setTimeout(() => {
      iframe.src = videoId;
    }, 100);
  }

  function closeVideoModal() {
    if (!modal || !iframe) return;
    iframe.src = '';
    modal.classList.remove('active');
  }

  if (modal) {
    modal.addEventListener('click', (e) => {
      if (!e.target.closest('.modal-content')) {
        closeVideoModal();
      }
    });
  }

  // Nasłuchiwanie kliknięć na całym .video-item (wrapper wokół video)
  const videoItems = document.querySelectorAll('.videos-item');
  videoItems.forEach(item => {
    item.addEventListener('click', () => {
      const video = item.querySelector('video');
      if (video) {
        openVideoModal(video);
      }
    });
  });

  // Lazy loading video z obsługą błędów play/pause
  const videos = document.querySelectorAll('.video-item video');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const playPromise = entry.target.play();
        if (playPromise !== undefined) {
          playPromise.catch(error => {
            if (error.name !== 'AbortError') {
              console.error('Video play error:', error);
            }
          });
        }
      } else {
        entry.target.pause();
      }
    });
  });
  videos.forEach(v => observer.observe(v));

script.
  document.addEventListener('DOMContentLoaded', function () {
    const carousel = document.querySelector('#project-carousel');
    let startX = 0;

    if (carousel) {
      carousel.addEventListener('touchstart', (e) => {
        startX = e.touches[0].clientX;
      });

      carousel.addEventListener('touchend', (e) => {
        const endX = e.changedTouches[0].clientX;
        const diffX = startX - endX;

        if (Math.abs(diffX) > 50) {
          const direction = diffX > 0 ? 'next' : 'prev';
          $(carousel).carousel(direction); // jQuery Bootstrap API
        }
      });
    }
  });

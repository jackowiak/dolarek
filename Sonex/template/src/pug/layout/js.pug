script.
  const modal = document.getElementById('video-modal');
  const iframe = document.getElementById('yt-player');

  function openVideoModal(el) {
    const videoId = el.dataset.videoId;
    
    // Pokaż modal najpierw
    modal.classList.add('active');
    
    // Dopiero po krótkim czasie ustaw src (lepsze wsparcie dla Safari)
    setTimeout(() => {
      iframe.src = `${videoId}`;
    }, 100);
  }

  function closeVideoModal() {
    iframe.src = ''; // Zatrzymaj wideo
    modal.classList.remove('active');
  }

  // Klik poza modal-content = zamknij
  modal.addEventListener('click', (e) => {
    if (!e.target.closest('.modal-content')) {
      closeVideoModal();
    }
  });

  // Lazy loading dla video
  const videos = document.querySelectorAll('.project-image video');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.play();
      } else {
        entry.target.pause();
      }
    });
  });

  videos.forEach(v => observer.observe(v));

script.
  document.addEventListener('DOMContentLoaded', function () {
    const carousel = document.querySelector('#project-carousel');
    let startX = 0;

    if (carousel) {
      carousel.addEventListener('touchstart', (e) => {
        startX = e.touches[0].clientX;
      });

      carousel.addEventListener('touchend', (e) => {
        const endX = e.changedTouches[0].clientX;
        const diffX = startX - endX;

        if (Math.abs(diffX) > 50) {
          const direction = diffX > 0 ? 'next' : 'prev';
          $(carousel).carousel(direction); // jQuery Bootstrap API
        }
      });
    }
  });


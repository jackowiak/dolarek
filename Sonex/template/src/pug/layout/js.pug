script.
  const modal = document.getElementById('video-modal');
  const iframe = document.getElementById('yt-player');

  function openVideoModal(el) {
    const videoId = el.closest('.project-image').querySelector('video').dataset.videoId;
    
    // Pokaż modal najpierw
    modal.classList.add('active');
    
    // Dopiero po krótkim czasie ustaw src (lepsze wsparcie dla Safari)
    setTimeout(() => {
      iframe.src = `https://www.youtube.com/embed/${videoId}?autoplay=1&playsinline=1&rel=0&modestbranding=1`;
    }, 100);
  }

  function closeVideoModal() {
    iframe.src = ''; // Zatrzymaj wideo
    modal.classList.remove('active');
  }

  // Klik poza modal-content = zamknij
  modal.addEventListener('click', (e) => {
    if (!e.target.closest('.modal-content')) {
      closeVideoModal();
    }
  });

  // Lazy loading dla video
  const videos = document.querySelectorAll('.project-image video');
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.play();
      } else {
        entry.target.pause();
      }
    });
  });

  videos.forEach(v => observer.observe(v));


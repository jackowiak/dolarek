extends layout/head

block title
  title DOLLAR MODA by Henryk Brzeski

block content
  body#project-page
    .global-outer
      .global-inner
        header#sidebar
          .sidebar-inner
            include layout/navigation
        main#main
          .main-outer.videos-grid
            .container-fluid

              //- Definicja mixina video-item z argumentami
              mixin video-item(src, dataVideoId, title, list)
                .row
                  .col-md-12
                    .videos-item(data-video-id=dataVideoId)
                      .picture
                        .content
                          .text
                            h2= title
                            ul
                              each val in list
                                li=val
                        video(
                          src=src
                          autoplay
                          loop
                          muted
                          playsinline
                        )

              //- Wywołania mixina z różnymi video
              +video-item('img/projects/video/tylemam.mp4', 'https://iframe.mediadelivery.net/embed/425607/039711d6-f60f-4f48-9825-44655a582c52?autoplay=true&loop=false&muted=false&preload=true&responsive=true', 'Ćpaj Stajl - Tyle Mam', ['Director'])
              +video-item('img/projects/video/tacet.mp4', 'https://iframe.mediadelivery.net/embed/425607/55c500b8-3a3a-48f6-a019-9f07dac49d64?autoplay=true&loop=false&muted=false&preload=true&responsive=true', 'Tacet - Flare', ['Director'])
              +video-item('img/projects/video/bnr.mp4', 'https://iframe.mediadelivery.net/embed/425607/883c9163-dabb-484a-b801-62070b03eb87?autoplay=true&loop=false&muted=false&preload=true&responsive=true', 'Żabson & Young Igi - Buty Na Rzepy', ['Director'])
              +video-item('img/projects/video/proch.mp4', 'https://iframe.mediadelivery.net/embed/425607/476d8d88-4438-4865-a73f-820a8012cd88?autoplay=true&loop=false&muted=false&preload=true&responsive=true', 'Koza x Molehead - Proch', ['Director'])
              +video-item('img/projects/video/catchup.mp4', 'https://iframe.mediadelivery.net/embed/425607/cb28fb6a-d8ef-4e19-9d1c-880968adc715?autoplay=true&loop=false&muted=false&preload=true&responsive=true', 'Catchup - Łopian', ['Director'])
              +video-item('img/projects/video/kemo.mp4', 'https://iframe.mediadelivery.net/embed/425607/f00126b4-242e-4a93-aaa4-b440beacfde0?autoplay=true&loop=false&muted=false&preload=true&responsive=true', 'Kemo Brane - Don’t Lie', ['Director'])
              +video-item('img/projects/video/synek.mp4', 'https://iframe.mediadelivery.net/embed/425607/f32ac0d6-a36a-476c-9ab9-7bf97da26d15?autoplay=true&loop=false&muted=false&preload=true&responsive=true', 'Ćpaj Stajl - Młody Synek', ['Director'])
              +video-item('img/projects/video/bdawg.mp4', 'https://iframe.mediadelivery.net/embed/425607/7e310ffd-e5f5-4895-8ec8-d0c951eb59d2?autoplay=true&loop=false&muted=false&preload=true&responsive=true', 'Belmondawg - Te Tereny', ['Director'])

          //- Modal do YouTube
          #video-modal.modal
            .modal-content
              iframe#yt-player(
                width='100%'
                height='100%'
                frameborder='0'
                allow='autoplay; fullscreen'
                allowfullscreen
                playsinline
								style='visibility: hidden'
              )
            button.close(onclick='closeVideoModal()') ✕

    include layout/js

extends layout/head
block title
	title DOLLAR MODA by Henryk Brzeski
block content
	body#project-page
		.global-outer
			.global-inner
				header#sidebar
					.sidebar-inner
						include layout/navigation
				main#main
					.main-outer
						.container-fluid
							.row
								.col-md-12
									.title-image
										img(src='img/projects/cs_lwg/1.png' alt='')
							.row
								.col-md-9
									.description
										h1 Ćpaj stajl - Lato w Ghettcie
										ul.categories
											li Vinyl release design
										p
											| I used scissors to rip up some Playboy magazines. The images of bodies and underwear seemed like perfect components for this childish, silly-looking illustration of a bloke smashing a cop. This came from my time exploring the hood as a child - making my first tags and scratches, and witnessing clashes between football gangs.
										p
											|
								.col-md-3
									.details
										ul
											li
												| Date:
												span April 2023
											li
												| Client:
												span Ćpaj Stajl
							.row
								.col-md-6
									.project-image
										img(src='img/projects/cs_lwg/5.png' alt='')
								.col-md-6
									.project-image
										img(src='img/projects/cs_lwg/6.png' alt='')
							.row
								.col-md-12
									#project-carousel.carousel.slide
										ol.carousel-indicators
											li.active(data-target='.carousel' data-slide-to='0')
											li(data-target='.carousel' data-slide-to='1')
											li(data-target='.carousel' data-slide-to='2')
											li(data-target='.carousel' data-slide-to='3')
											li(data-target='.carousel' data-slide-to='4')
										.carousel-inner
											.item.active
												img(src='img/projects/cs_lwg/c1.png' alt='')
											.item
												img(src='img/projects/cs_lwg/c2.png' alt='')
											.item
												img(src='img/projects/cs_lwg/c3.png' alt='')
											.item
												img(src='img/projects/cs_lwg/c4.png' alt='')
											.item
												img(src='img/projects/cs_lwg/c5.png' alt='')
		include layout/js
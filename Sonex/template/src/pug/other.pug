extends layout/head
block title
	title DOLLAR MODA by Henryk Brzeski
block content
	body#project-page
		.global-outer
			.global-inner
				header#sidebar
					.sidebar-inner
						include layout/navigation
				main#main
					.main-outer
						.container-fluid
							.row
								.col-md-12
									.title-image
										img(src='img/projects/other/2.png' alt='')
							.row
								.col-md-9
									.description
										h1 Rest of works 2023-2025
										ul.categories
											li From other orbits
										p
											| Single graphics and covers, updated continuously.

										p
											|
								.col-md-3
									.details
										ul
											li
												| Date:
												span 2023-2025
							.row
								.col-md-12
									.project-image
										img(src='img/projects/other/1.png' alt='')
								.col-md-12
									.project-image
										img(src='img/projects/other/2A.png' alt='')
								.col-md-12
									.project-image
										img(src='img/projects/other/3.png' alt='')
								.col-md-12
									.project-image
										img(src='img/projects/other/4.png' alt='')
								.col-md-12
									.project-image
										img(src='img/projects/other/4B.png' alt='')
								.col-md-12
									.project-image
										img(src='img/projects/other/5.png' alt='')
								.col-md-12
									.project-image
										img(src='img/projects/other/8.png' alt='')
								.col-md-12
									.project-image
										img(src='img/projects/other/delfinek.png' alt='')
								.col-md-12
									.project-image
										img(src='img/projects/other/wizard.png' alt='')
		include layout/js
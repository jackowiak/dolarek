extends layout/head

block title
	title DOLLAR MODA by Henryk Brzeski

block content
	body#contact-page
		.global-outer
			.global-inner
				header#sidebar
					.sidebar-inner
						include layout/navigation
				main#main
					.main-outer
						.container-fluid
							.page-title
								.row
									.col-md-12
										img(src='img/about_me_v2.png' alt='SO')
								.say-hello
									.row
										.col-md-12.text-center
											h4 CONTACT:
											.row
												.col-xs-12.about-contact-row
													a(href='mailto:dollarmoda@gmail.com' target='_blank')
														i.fas.fa-envelope.fa-3x
														span DOLLARMODA@GMAIL.COM
												.col-xs-12.about-contact-row
													a(href='https://www.instagram.com/dollarmoda' target='_blank')
														i.fab.fa-instagram.fa-3x
														span DOLLAR MODA

		include layout/js
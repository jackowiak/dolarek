extends layout/head
block title
	title Dollar Moda
block content
	body#project-page
		.global-outer
			.global-inner
				header#sidebar
					.sidebar-inner
						include layout/navigation
				main#main
					.main-outer
						.container-fluid
							.row
								.col-md-12
									.title-image
										img(src='img/projects/cs_zs/1.png' alt='')
							.row
								.col-md-9
									.description
										h1 Ćpaj stajl - Złoty Strzał 
										ul.categories
											li Typography
											li Branding
										p
											| Objects made from trash and papier-mâché, then photographed. The front features a sculpture: a satirical portrait of all the group members in the form of a single creature. The installation was created from trash found in the courtyards of Krakow's old town district.

										p
											|
								.col-md-3
									.details
										ul
											li
												| Date:
												span March 2022
											li
												| Client:
												span Ćpaj Stajl
							.row
								.col-md-12
									.project-image
										img(src='img/projects/cs_zs/2.png' alt='')
								.col-md-6
									.project-image
										img(src='img/projects/cs_zs/c1.png' alt='')
								.col-md-6
									.project-image
										img(src='img/projects/cs_zs/c2.png' alt='')
		include layout/js
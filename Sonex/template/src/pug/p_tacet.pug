extends layout/head
block title
	title SONEX – Project
block content
	body#project-page
		.global-outer
			.global-inner
				header#sidebar
					.sidebar-inner
						include layout/navigation
						include layout/copyright
				main#main
					.main-outer
						.container-fluid


							.row
								.col-md-12
									#project-carousel.carousel.slide
										ol.carousel-indicators
											li.active(data-target='.carousel' data-slide-to='0')
											li(data-target='.carousel' data-slide-to='1')
											li(data-target='.carousel' data-slide-to='2')
											li(data-target='.carousel' data-slide-to='3')
											li(data-target='.carousel' data-slide-to='4')
											li(data-target='.carousel' data-slide-to='5')
										.carousel-inner
											.item.active
												img(src='img/projects/tacet/karuzela1.jpg' alt='')
											.item
												img(src='img/projects/tacet/karuzela2.jpg' alt='')
											.item
												img(src='img/projects/tacet/karuzela3.jpg' alt='')
											.item
												img(src='img/projects/tacet/karuzela4.jpg' alt='')
											.item
												img(src='img/projects/tacet/karuzela5.jpg' alt='')
											.item
												img(src='img/projects/tacet/karuzela6.jpg' alt='')
							.row
								.col-md-9
									.description
										h1 Tacet
										ul.categories
											li Typography
											li Branding
										p
											| I had the pleasure of overseeing and directing the entire visual concept for Wojtek Urbański's project - Tacet. This includes the logo, single covers (screen printing on a steel disc), and the music video for the track “Flare.”

										p
											|
								.col-md-3
									.details
										ul
											li
												| Date:
												span February 2024
											li
												| Client:
												span Dyspensa Records

							.row
								.col-md-12
									.project-image
										img(src='img/projects/tacet/2.png' alt='')
							.row
								.col-md-6
									.project-image
										.caption First Mockup
										img(src='img/projects/tacet/3.png' alt='')
								.col-md-6
									.project-image
										.caption Second Mockup
										img(src='img/projects/tacet/4.png' alt='')
								.col-md-12
									.project-image
										iframe(src='https://www.youtube.com/embed/ntCnydwV5wM' alt='' width="1431" height="609" title="TACET - Flare" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen)

		include layout/js
extends layout/head
block title
	title Dollar Moda
block content
	body#project-page
		.global-outer
			.global-inner
				header#sidebar
					.sidebar-inner
						include layout/navigation
				main#main
					.main-outer
						.container-fluid
							.row
								.col-md-12
									.title-image
										img(src='img/projects/cs_melodramat/1.png' alt='')
							.row
								.col-md-12
									.project-image
										img(src='img/projects/cs_melodramat/sub1.png' alt='')
								.col-md-12
									.project-image
										img(src='img/projects/cs_melodramat/sub2.png' alt='')
		
							.row
								.col-md-9
									.description
										h1 Ćpaj Stajl - Melodramat
										ul.categories
											li Typography
											li Branding
										p
											| This depressive EP deserved an equally catastrophic protagonist. A humanoid piano with a trumpet emerging from its face. I crafted the object out of clay. The eyes are real—I found them in a dumpster at the fish market during the Christmas season. I wanted them to have a genuine look of pain.

										p
											|
								.col-md-3
									.details
										ul
											li
												| Date:
												span December 2019
											li
												| Client:
												span Ćpaj Stajl
							.row
								.col-md-12
									#project-carousel.carousel.slide
										ol.carousel-indicators
											li.active(data-target='.carousel' data-slide-to='0')
											li(data-target='.carousel' data-slide-to='1')
											li(data-target='.carousel' data-slide-to='2')
											li(data-target='.carousel' data-slide-to='3')
										.carousel-inner
											.item.active
												img(src='img/projects/cs_melodramat/c1.png' alt='')
											.item
												img(src='img/projects/cs_melodramat/c2.png' alt='')
											.item
												img(src='img/projects/cs_melodramat/c3.png' alt='')
											.item
												img(src='img/projects/cs_melodramat/c4.png' alt='')
		include layout/js
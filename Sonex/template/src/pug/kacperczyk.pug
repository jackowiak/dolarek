extends layout/head
block title
	title DOLLAR MODA by Henryk Brzeski
block content
	body#project-page
		.global-outer
			.global-inner
				header#sidebar
					.sidebar-inner
						include layout/navigation
				main#main
					.main-outer
						.container-fluid
							.row
								.col-md-12
									.title-image
										img(src='img/projects/kacperczyk/1.png' alt='')
							.row
								.col-md-9
									.description
										h1 Kacperczyk - Posters
										ul.categories
											li Poster series
										p
											| Posters illustrating each city visited by the Kacperczyk brothers during the "End of the World Tour."
								.col-md-3
									.details
										ul
											li
												| Date:
												span February 2024
											li
												| Client:
												span SBM Label
							.row
								.col-md-6
									.project-image
										img(src='img/projects/kacperczyk/5.png' alt='')
								.col-md-6
									.project-image
										img(src='img/projects/kacperczyk/6.png' alt='')
								.col-md-12
									.project-image
										img(src='img/projects/kacperczyk/4.png' alt='')
								.col-md-6
									.project-image
										img(src='img/projects/kacperczyk/3.png' alt='')
								.col-md-6
									.project-image
										img(src='img/projects/kacperczyk/7.png' alt='')
								.col-md-12
									.project-image
										img(src='img/projects/kacperczyk/2.png' alt='')
		include layout/js